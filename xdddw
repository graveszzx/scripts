    pcall(function()
        if listfiles and isfolder and isfolder(x1) then
            for _, path in ipairs(listfiles(x1)) do
                local norm = tostring(path):gsub("\\", "/")
                local fname = norm:match("([^/]+)%.json$")
                if fname and fname ~= "" then
                    table.insert(list, fname)
                end
            end
        end
    end)
    table.sort(list)
    if #list == 0 then table.insert(list, "None") end
    return list
end

local function d5(pickName)
    local list = f5()
    if pickName and table.find(list, pickName) then
        selectedConfigName = pickName
    elseif not table.find(list, selectedConfigName) then
        selectedConfigName = list[1] ~= "None" and list[1] or ""
    end
    if configDropdownControl then
        pcall(function()
            if configDropdownControl.Refresh then
                configDropdownControl:Refresh(list, selectedConfigName ~= "" and selectedConfigName or list[1])
            elseif configDropdownControl.SetValues then
                configDropdownControl:SetValues(list)
            end
        end)
    end
end

local function m5(cfgName)
    local clean = z5(cfgName)
    if clean == "" or clean == "None" then
        Fluent:Notify({Title="Aeris Configs", Content="Enter a valid config name first!", Duration=3})
        return false
    end
    local path = x1 .. "/" .. clean .. ".json"
    local ok = pcall(function()
        if isfolder and makefolder and not isfolder(x1) then
            makefolder(x1)
        end
        writefile(path, HttpService:JSONEncode(u2))
    end)
    if ok then
        d5(clean)
        Fluent:Notify({Title="Aeris Configs", Content="Saved config: " .. clean, Duration=2})
        return true
    else
        Fluent:Notify({Title="Aeris Configs", Content="Failed to save config!", Duration=3})
        return false
    end
end

local function n5(cfgName)
    local clean = z5(cfgName)
    if clean == "" or clean == "None" then
        Fluent:Notify({Title="Aeris Configs", Content="Select a valid config first!", Duration=3})
        return false
    end
    local path = x1 .. "/" .. clean .. ".json"
    if not (isfile and isfile(path)) then
        Fluent:Notify({Title="Aeris Configs", Content="Config file not found: " .. clean, Duration=3})
        return false
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or type(decoded) ~= "table" then
        Fluent:Notify({Title="Aeris Configs", Content="Config file is corrupted!", Duration=3})
        return false
    end
    for flag, val in pairs(decoded) do
        u2[flag] = val
        local entry = p2[flag]
        if entry then
            if entry.kind == "toggle" then
                q2(flag, val)
            else
                pcall(function()
                    if entry.control then
                        if entry.control.Set then entry.control:Set(val)
                        elseif entry.control.SetValue then entry.control:SetValue(val) end
                    end
                end)
                if entry.callback then
                    pcall(entry.callback, val)
                end
            end
        end
    end
    Fluent:Notify({Title="Aeris Configs", Content="Loaded config: " .. clean, Duration=2})
    return true
end

local function v6(cfgName)
    local clean = z5(cfgName)
    if clean == "" or clean == "None" then
        Fluent:Notify({Title="Aeris Configs", Content="Select a valid config to delete!", Duration=3})
        return false
    end
    local path = x1 .. "/" .. clean .. ".json"
    if isfile and isfile(path) and delfile then
        pcall(delfile, path)
        if isfile(q1) and readfile(q1) == clean then
            pcall(delfile, q1)
        end
        selectedConfigName = ""
        d5()
        Fluent:Notify({Title="Aeris Configs", Content="Deleted config: " .. clean, Duration=2})
        return true
    else
        Fluent:Notify({Title="Aeris Configs", Content="Could not delete config!", Duration=3})
        return false
    end
end

