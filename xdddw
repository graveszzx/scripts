local u2 = {}
local p2 = {}
local c2 = 0

local function x2(flag, kind, defaultVal, callback, ctrl)
    if not flag or flag == "" then return end
    u2[flag] = defaultVal
    p2[flag] = {
        kind = kind,
        callback = callback,
        control = ctrl
    }
end

local function q2(flag, newState)
    local entry = p2[flag]
    if not entry then return end
    local callbackFired = false
    entry._onSet = function()
        callbackFired = true
    end
    if entry.control then
        pcall(function()
            if entry.control.Set then
                entry.control:Set(newState)
            elseif entry.control.SetValue then
                entry.control:SetValue(newState)
            end
        end)
    end
    entry._onSet = nil
    if not callbackFired and entry.callback then
        pcall(entry.callback, newState)
    end
end

function Window:AddTab(options)
    local tab = self:Tab({Title = options.Title, Icon = options.Icon})
    function tab:AddSection(title, icon)
        pcall(function() self:Section({Title = title, Icon = icon}) end)
        local section = {}
        function section:AddToggle(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then
                    u2[flag] = v
                    local reg = p2[flag]
                    if reg and reg._onSet then reg._onSet() end
                end
                if origCb then origCb(v) end
            end
            local ctrl = tab:Toggle({Title=cfg.Title, Desc=cfg.Description, Value=cfg.Default, Callback=wrappedCb})
            x2(flag, "toggle", cfg.Default or false, wrappedCb, ctrl)
            return ctrl
        end
        function section:AddDropdown(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then u2[flag] = v end
                if origCb then origCb(v) end
            end
            local ctrl = tab:Dropdown({Title=cfg.Title, Desc=cfg.Description, Values=cfg.Values, Value=cfg.Default, Multi=cfg.Multi, Callback=wrappedCb})
            x2(flag, "dropdown", cfg.Default, wrappedCb, ctrl)
            return ctrl
        end
        function section:AddSlider(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then u2[flag] = v end
                if origCb then origCb(v) end
            end
            local ctrl = tab:Slider({Title=cfg.Title, Desc=cfg.Description, Value={Min=cfg.Min, Max=cfg.Max, Default=cfg.Default}, Rounding=cfg.Rounding, Callback=wrappedCb})
            x2(flag, "slider", cfg.Default, wrappedCb, ctrl)
            return ctrl
        end
        function section:AddInput(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then u2[flag] = v end
                if origCb then origCb(v) end
            end
            local ctrl = tab:Input({Title=cfg.Title, Desc=cfg.Description, Placeholder=cfg.Placeholder, Value=cfg.Default, Callback=wrappedCb})
            x2(flag, "input", cfg.Default or "", wrappedCb, ctrl)
            return ctrl
        end
        function section:AddKeybind(flag, cfg)
            local origChanged = cfg.ChangedCallback
            local handleKeyUpdate = function(v)
                if v == nil or type(v) == "boolean" then return end
                local clean = tostring(v):match("Enum%.KeyCode%.(.+)") or tostring(v)
                if clean ~= "" and Enum.KeyCode[clean] then
                    if u2[flag] ~= clean then
                        c2 = tick()
                        if flag then u2[flag] = clean end
                        if origChanged then origChanged(clean) end
                    end
                end
            end
            local ctrl = tab:Keybind({
                Title = cfg.Title,
                Desc = cfg.Description,
                Value = cfg.Default,
                Callback = handleKeyUpdate,
                ChangedCallback = handleKeyUpdate
            })
            x2(flag, "keybind", cfg.Default, handleKeyUpdate, ctrl)
            return ctrl
        end
        function section:AddButton(_, cfg)
            return tab:Button({Title=cfg.Title, Desc=cfg.Description, Icon=cfg.Icon, Callback=cfg.Callback})
        end
        return section
    end
    return tab
end

