        bg.ImageTransparency = 0.22; bg.ScaleType = Enum.ScaleType.Crop; bg.Parent = Frame
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,18); c.Parent = bg
    end

    local function makeAccent(ax,ay,px,py,w,h)
