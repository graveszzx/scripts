        minBtn.MouseLeave:Connect(function()
            tw(minBtn, 0.1, {TextColor3 = Theme.Accent})
        end)
    end

    do
        local line = Instance.new("Frame"); line.ZIndex = 3
        line.Position = UDim2.new(0,12,0,46); line.Size = UDim2.new(1,-24,0,1)
        line.BackgroundColor3 = Theme.Accent; line.BackgroundTransparency = 0.6
        line.BorderSizePixel = 0; line.Parent = Frame
        local acc = Instance.new("Frame"); acc.ZIndex = 4
        acc.Position = UDim2.new(0,12,0,45); acc.Size = UDim2.new(0,44,0,2)
        acc.BackgroundColor3 = Theme.Accent; acc.BorderSizePixel = 0; acc.Parent = Frame
        local ac = Instance.new("UICorner"); ac.CornerRadius = UDim.new(1,0); ac.Parent = acc
    end

    local ResizeHandle = Instance.new("TextButton")
    ResizeHandle.Name = "ResizeHandle"; ResizeHandle.ZIndex = 50
    ResizeHandle.AnchorPoint = Vector2.new(1,1)
    ResizeHandle.Position = UDim2.new(1,0,1,0)
    ResizeHandle.Size = UDim2.new(0,20,0,20)
    ResizeHandle.BackgroundTransparency = 1; ResizeHandle.Text = "◢"
    ResizeHandle.TextColor3 = Theme.Accent; ResizeHandle.TextSize = 12
    ResizeHandle.Font = Enum.Font.GothamBold; ResizeHandle.Parent = Frame

    _uiSizeRef.w = W
    _uiSizeRef.h = H
    _applyUISizeCallback = function(nw, nh)
        if nw and nw > 0 and nh and nh > 0 then
            local mobile2 = isMobile()
            local minW2 = mobile2 and 300 or 440
            local minH2 = mobile2 and 340 or 420
            local maxW2 = mobile2 and 520 or 1300
            local maxH2 = mobile2 and 660 or 920
            local fw = math.clamp(nw, minW2, maxW2)
            local fh = math.clamp(nh, minH2, maxH2)
            _currentW = fw; _currentH = fh
            _uiSizeRef.w = fw; _uiSizeRef.h = fh
            Frame.Size = UDim2.new(0, fw, 0, fh)
        end
    end

    local _currentW = W
    local _currentH = H
    do
        local minW = mobile and 300 or 440
        local minH = mobile and 340 or 420
        local maxW = mobile and 520 or 1300
        local maxH = mobile and 660 or 920
        local resizing, resizeStart, startSize = false, nil, nil
        local targetW, targetH = W, H
        local _resizeTween = nil

        ResizeHandle.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                resizeStart = Vector2.new(i.Position.X, i.Position.Y)
                startSize = Vector2.new(Frame.AbsoluteSize.X, Frame.AbsoluteSize.Y)
                targetW = startSize.X
                targetH = startSize.Y
            end
        end)

        UserInputService.InputChanged:Connect(function(i)
            if not resizing then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
            local delta = Vector2.new(i.Position.X, i.Position.Y) - resizeStart
            local nw = math.clamp(startSize.X + delta.X, minW, maxW)
            local nh = math.clamp(startSize.Y + delta.Y, minH, maxH)
            if math.abs(nw - targetW) > 1 or math.abs(nh - targetH) > 1 then
                targetW = nw
                targetH = nh
                _currentW = nw
                _currentH = nh
                _uiSizeRef.w = nw
                _uiSizeRef.h = nh
                if _resizeTween then _resizeTween:Cancel() end
                _resizeTween = TweenService:Create(Frame,
                    TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {Size = UDim2.new(0, nw, 0, nh)}
                )
                _resizeTween:Play()
            end
        end)

        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)
    end

    local SIDEBAR_W = mobile and 100 or 132
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"; Sidebar.ZIndex = 4
    Sidebar.Position = UDim2.new(0,10,0,50); Sidebar.Size = UDim2.new(0,SIDEBAR_W,1,-58)
    Sidebar.BackgroundTransparency = 1; Sidebar.BorderSizePixel = 0; Sidebar.Parent = Frame
    do
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,18); c.Parent = Sidebar
        local rail = Instance.new("Frame"); rail.ZIndex = 3
        rail.Position = UDim2.new(1,2,0,5); rail.Size = UDim2.new(0,2,1,-10)
        rail.BackgroundColor3 = Theme.Accent; rail.BorderSizePixel = 0; rail.Parent = Sidebar
        local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(1,0); rc.Parent = rail
        local rg = Instance.new("UIGradient"); rg.Rotation = 90
        rg.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1,0),
            NumberSequenceKeypoint.new(0.5,0.15,0),
            NumberSequenceKeypoint.new(1,  1,0),
        }); rg.Parent = rail
    end

    local NavScroll = Instance.new("ScrollingFrame")
    NavScroll.ZIndex = 5; NavScroll.Position = UDim2.new(0,4,0,4)
    NavScroll.Size = UDim2.new(1,-8,1,-8)
    NavScroll.BackgroundTransparency = 1; NavScroll.BorderSizePixel = 0
    NavScroll.ScrollBarThickness = 0; NavScroll.CanvasSize = UDim2.new(0,0,0,0)
    NavScroll.ScrollingDirection = Enum.ScrollingDirection.Y
    NavScroll.Parent = Sidebar

    local NavList = Instance.new("Frame")
    NavList.ZIndex = 5; NavList.Size = UDim2.new(1,0,0,0)
    NavList.BackgroundTransparency = 1; NavList.BorderSizePixel = 0
    NavList.Parent = NavScroll
    do
        local ul = Instance.new("UIListLayout")
        ul.Padding = UDim.new(0, mobile and 5 or 6)
        ul.HorizontalAlignment = Enum.HorizontalAlignment.Center
        ul.SortOrder = Enum.SortOrder.LayoutOrder; ul.Parent = NavList
        ul:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            NavList.Size = UDim2.new(1,0,0, ul.AbsoluteContentSize.Y + 8)
            NavScroll.CanvasSize = UDim2.new(0,0,0, ul.AbsoluteContentSize.Y + 8)
        end)
    end

    local CONTENT_X = SIDEBAR_W + 22
    local ScrollingFrame = Instance.new("ScrollingFrame")
    ScrollingFrame.Name = "ContentScroll"
    ScrollingFrame.Position = UDim2.new(0,CONTENT_X,0,52)
    ScrollingFrame.Size = UDim2.new(1,-(CONTENT_X+10),1,-62)
    ScrollingFrame.BackgroundTransparency = 1; ScrollingFrame.BorderSizePixel = 0
    ScrollingFrame.ScrollBarThickness = 3
    ScrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(170,45,45)
    ScrollingFrame.ScrollBarImageTransparency = 0.35
    ScrollingFrame.CanvasSize = UDim2.new(0,0,0,0); ScrollingFrame.Parent = Frame
    do
        local ul = Instance.new("UIListLayout"); ul.SortOrder = Enum.SortOrder.LayoutOrder; ul.Parent = ScrollingFrame
    end

    local RainFX = Instance.new("Frame")
    RainFX.ClipsDescendants = true; RainFX.Position = UDim2.new(0,8,0,80)
    RainFX.Size = UDim2.new(1,-16,1,-88); RainFX.BackgroundTransparency = 1
    RainFX.BorderSizePixel = 0; RainFX.Parent = Frame
    for _,d in ipairs({
        {0.459,-.103,9},{0.852,.179,8},{0.292,.665,10},{0.644,.977,12},
        {0.779,.951,9},{0.088,.463,10},{0.284,-.003,7},{0.697,.717,9},
        {0.049,-.425,11},{0.978,1.035,8},{0.626,.053,8},{0.141,.415,9},
        {0.066,.775,7},{0.437,-.327,10},{0.755,-.213,7},{0.549,1.050,12},
        {0.854,.922,10},{0.564,.137,10},{0.919,.178,8},{0.723,.430,10},
        {0.642,.835,8},{0.835,.715,7},{0.762,.433,9},{0.559,.158,8},
        {0.166,.988,11},{0.266,-.046,11},{0.442,-.332,9},{0.501,.618,7},
        {0.331,.717,10},{0.014,.356,10},{0.468,.818,10},{0.816,.471,7},
    }) do
        local f = Instance.new("Frame")
        f.Position = UDim2.new(d[1],0,d[2],0); f.Size = UDim2.new(0,1,0,d[3])
        f.BackgroundColor3 = Theme.RainColor; f.BackgroundTransparency = 0.6
        f.BorderSizePixel = 0; f.Parent = RainFX
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1,0); c.Parent = f
        local g = Instance.new("UIGradient"); g.Rotation = 90
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,  1,0),
            NumberSequenceKeypoint.new(0.5,0.4,0),
            NumberSequenceKeypoint.new(1,  1,0),
        }); g.Parent = f
    end

    local MinBubble
    if mobile then
        MinBubble = Instance.new("TextButton")
        MinBubble.Visible = false; MinBubble.ZIndex = 100
        MinBubble.AnchorPoint = Vector2.new(0.5, 1)
        MinBubble.Position = UDim2.new(0.5, 0, 1, -40)
        MinBubble.Size = UDim2.new(0, 56, 0, 56)
        MinBubble.BackgroundColor3 = Color3.fromRGB(10,10,10)
        MinBubble.BackgroundTransparency = 0
        MinBubble.BorderSizePixel = 0
        MinBubble.Text = ""
        MinBubble.AutoButtonColor = false
        MinBubble.Parent = ScreenGui
        do
            local mbc = Instance.new("UICorner"); mbc.CornerRadius = UDim.new(1,0); mbc.Parent = MinBubble
            local mbs = Instance.new("UIStroke"); mbs.Color = Theme.Accent; mbs.Transparency = 0.25; mbs.Thickness = 2; mbs.Parent = MinBubble
            local mbImg = Instance.new("ImageLabel")
            mbImg.ZIndex = 101; mbImg.Size = UDim2.new(1,0,1,0)
            mbImg.BackgroundTransparency = 1; mbImg.Image = BgImage
            mbImg.ImageTransparency = 0.1; mbImg.ScaleType = Enum.ScaleType.Crop
            mbImg.Parent = MinBubble
            local mbImgC = Instance.new("UICorner"); mbImgC.CornerRadius = UDim.new(1,0); mbImgC.Parent = mbImg

            local dragging, dragStart, startPos, dragMoved = false, nil, nil, false
            MinBubble.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; dragMoved = false
                    dragStart = i.Position
                    startPos = MinBubble.Position
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.Touch then
                    local d = i.Position - dragStart
                    if math.abs(d.X) > 6 or math.abs(d.Y) > 6 then dragMoved = true end
                    MinBubble.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + d.X,
                        startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)
        end
    else
        -- PC: MinBubble nunca aparece; UI fecha/abre via keybind nas configs
        MinBubble = Instance.new("TextButton")
        MinBubble.Visible = false
        MinBubble.Size = UDim2.new(0,1,0,1)
        MinBubble.BackgroundTransparency = 1
        MinBubble.Text = ""
        MinBubble.AutoButtonColor = false
        MinBubble.Parent = ScreenGui
    end

    local minimised = false
    local animating = false

    local function setMinimised(v)
        if animating then return end
        animating = true
        minimised = v
        local scale = mobile and 0.85 or 1
        if v then
            local shrinkW = _currentW * scale * 0.05
            local shrinkH = _currentH * scale * 0.05
            tw(Frame, 0.22, {Size = UDim2.new(0, shrinkW, 0, shrinkH)})
            TweenService:Create(Frame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
            task.delay(0.2, function()
                Frame.Visible = false
                Frame.BackgroundTransparency = 0
                if mobile then
                    MinBubble.Visible = true
                end
                animating = false
            end)
        else
            if mobile then MinBubble.Visible = false end
            Frame.Visible = true
            Frame.Size = UDim2.new(0, _currentW * scale * 0.05, 0, _currentH * scale * 0.05)
            Frame.BackgroundTransparency = 1
            tw(Frame, 0.25, {Size = UDim2.new(0, _currentW, 0, _currentH)})
            TweenService:Create(Frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
            task.delay(0.26, function()
                animating = false
            end)
        end
    end

    TitleBar:FindFirstChild("_MinBtn").MouseButton1Click:Connect(function()
        setMinimised(not minimised)
    end)
    MinBubble.MouseButton1Click:Connect(function() setMinimised(false) end)

    do
        local dragging, dragStart, startPos = false, nil, nil
        TitleBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = i.Position; startPos = Frame.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - dragStart
                Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X,
                                           startPos.Y.Scale, startPos.Y.Offset+d.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local Window       = {}
    Window._navTabs    = {}
    Window._activeIdx  = nil

    local function switchTab(idx)
        for i, t in ipairs(Window._navTabs) do
            local a = (i == idx)
            t.page.Visible = a
            tw(t.fill, 0.18, {Size = UDim2.new(a and 1 or 0, 0, 1, 0)})
            tw(t.bar,  0.18, {BackgroundTransparency = a and 0 or 1})
            tw(t.lbl,  0.18, {TextColor3 = a and Theme.TextPrimary or Theme.TextSecondary})
        end
        Window._activeIdx = idx
    end

    function Window:AddTab(label, _forceOrder)
        local idx    = #self._navTabs + 1
        local active = (idx == 1)

        local bg = Instance.new("Frame")
        bg.ZIndex = 5; bg.LayoutOrder = _forceOrder or idx; bg.ClipsDescendants = true
        bg.Size = UDim2.new(1,0,0,36); bg.BackgroundColor3 = Color3.fromRGB(14,14,16)
        bg.BackgroundTransparency = active and 0.1 or 0.25
        bg.BorderSizePixel = 0; bg.Parent = NavList
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,12); bc.Parent = bg
        local bs = Instance.new("UIStroke"); bs.Color = Theme.Border
        bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        bs.Transparency = active and 0.1 or 0.5; bs.Parent = bg

        local fill = Instance.new("Frame"); fill.ZIndex = 6
        fill.Size = UDim2.new(active and 1 or 0,0,1,0)
        fill.BackgroundColor3 = Theme.Accent; fill.BorderSizePixel = 0; fill.Parent = bg
        local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0,12); fc.Parent = fill
        local fg = Instance.new("UIGradient"); fg.Transparency = NumberSequence.new(0.25,0.72); fg.Parent = fill

        local bar = Instance.new("Frame"); bar.ZIndex = 8
        bar.Position = UDim2.new(0,0,0.225,0); bar.Size = UDim2.new(0,3,0.55,0)
        bar.BackgroundColor3 = Theme.Accent
        bar.BackgroundTransparency = active and 0 or 1
        bar.BorderSizePixel = 0; bar.Parent = bg
        local barc = Instance.new("UICorner"); barc.CornerRadius = UDim.new(1,0); barc.Parent = bar

        local lbl = Instance.new("TextLabel"); lbl.ZIndex = 7
        lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1; lbl.Text = label
        lbl.TextColor3 = active and Theme.TextPrimary or Theme.TextSecondary
        lbl.TextSize = mobile and 10 or 12; lbl.Font = Enum.Font.GothamBold; lbl.Parent = bg

        local btn = Instance.new("TextButton"); btn.ZIndex = 8
        btn.Size = UDim2.new(1,0,1,0); btn.BackgroundTransparency = 1
        btn.Text = ""; btn.AutoButtonColor = false; btn.Parent = bg

        local page = Instance.new("Frame"); page.Name = "Page_"..label
        page.Visible = active; page.Size = UDim2.new(1,0,0,0)
        page.BackgroundTransparency = 1; page.BorderSizePixel = 0; page.Parent = ScrollingFrame

        local ul = Instance.new("UIListLayout")
        ul.Padding = UDim.new(0,8); ul.SortOrder = Enum.SortOrder.LayoutOrder; ul.Parent = page
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0,7); pad.PaddingBottom = UDim.new(0,10)
        pad.PaddingLeft = UDim.new(0,7); pad.PaddingRight = UDim.new(0,7); pad.Parent = page

        ul:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.Size = UDim2.new(1,0,0, ul.AbsoluteContentSize.Y + 17)
            local total = 0
            for _,child in ipairs(ScrollingFrame:GetChildren()) do
                if child:IsA("Frame") then total += child.AbsoluteSize.Y end
            end
            ScrollingFrame.CanvasSize = UDim2.new(0,0,0,total+20)
        end)

        table.insert(self._navTabs, {page=page, fill=fill, bar=bar, lbl=lbl})
        if active then self._activeIdx = 1 end

        btn.MouseButton1Click:Connect(function() switchTab(idx) end)

        local Tab       = {}
        Tab._page       = page
        Tab._order      = 0

        local function tNextOrder()
            Tab._order += 1
            return Tab._order
        end

        function Tab:AddSection(text)
            local f = Instance.new("Frame")
            f.LayoutOrder = tNextOrder(); f.Size = UDim2.new(1,0,0,17)
            f.BackgroundTransparency = 1; f.BorderSizePixel = 0; f.Parent = self._page

            local dot = Instance.new("Frame")
            dot.Position = UDim2.new(0,8,0.5,-1); dot.Size = UDim2.new(0,10,0,2)
            dot.BackgroundColor3 = Color3.fromRGB(160,160,160); dot.BorderSizePixel = 0; dot.Parent = f
            local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(1,0); dc.Parent = dot

            local lbl2 = Instance.new("TextLabel")
            lbl2.Position = UDim2.new(0,24,0,0); lbl2.Size = UDim2.new(1,-30,1,0)
            lbl2.BackgroundTransparency = 1; lbl2.Text = text
            lbl2.TextColor3 = Theme.TextMuted; lbl2.TextSize = 10
            lbl2.Font = Enum.Font.GothamBold; lbl2.TextXAlignment = Enum.TextXAlignment.Left
            lbl2.Parent = f

            local Section      = {}
            Section._page      = self._page

            local function makeRow(sz)
                sz = sz or 40
                local r = Instance.new("Frame")
                r.ZIndex = 6; r.LayoutOrder = tNextOrder()
                r.Size = UDim2.new(1,-2,0,sz)
                r.BackgroundColor3 = Color3.fromRGB(255,255,255)
                r.BackgroundTransparency = 0.82; r.BorderSizePixel = 0; r.Parent = self._page
                local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,10); c.Parent = r
                local s = Instance.new("UIStroke"); s.Color = Theme.Border; s.Transparency = 0.6; s.Parent = r
                return r
            end

            local function rowLbl(parent, text2)
                local l = Instance.new("TextLabel")
                l.ZIndex = 8; l.Position = UDim2.new(0,11,0,0)
                l.Size = UDim2.new(0.58,0,1,0); l.BackgroundTransparency = 1; l.Text = text2
                l.TextColor3 = Theme.TextPrimary; l.TextSize = 11
                l.Font = Enum.Font.GothamBold; l.TextXAlignment = Enum.TextXAlignment.Left
                l.Parent = parent
            end

            local function makeBadge(parent, offX)
                local kb = Instance.new("TextButton")
                kb.ZIndex = 6; kb.Position = UDim2.new(1, offX or -106, 0.5, -11)
                kb.Size = UDim2.new(0,36,0,18); kb.BackgroundColor3 = Color3.fromRGB(16,16,20)
                kb.BorderSizePixel = 0; kb.Text = "bind"
                kb.TextColor3 = Color3.fromRGB(90,90,100); kb.TextSize = 9
                kb.Font = Enum.Font.GothamBold; kb.AutoButtonColor = false; kb.Parent = parent
                local kbc = Instance.new("UICorner"); kbc.CornerRadius = UDim.new(0,5); kbc.Parent = kb
                local kbs = Instance.new("UIStroke"); kbs.Color = Color3.fromRGB(60,60,70); kbs.Thickness = 1; kbs.Parent = kb
                return kb, kbs
            end

            local function wireKeybind(kb, kbs, onFire)
                local boundKey = nil
                local binding  = false

                local function refresh()
                    if binding then
                        kb.Text = "..."; kb.TextColor3 = Theme.Accent; kbs.Color = Theme.Accent
                    elseif boundKey then
                        kb.Text = boundKey; kb.TextColor3 = Theme.Accent; kbs.Color = Theme.Accent
                    else
                        kb.Text = "bind"; kb.TextColor3 = Color3.fromRGB(90,90,100); kbs.Color = Color3.fromRGB(60,60,70)
                    end
                end

                kb.MouseButton1Click:Connect(function()
                    if binding then binding = false; refresh(); return end
                    binding = true; refresh()
                end)

                UserInputService.InputBegan:Connect(function(input, gp)
                    if gp then return end
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if binding then
                        if input.KeyCode == Enum.KeyCode.Escape then binding = false; refresh(); return end
                        boundKey = input.KeyCode.Name; binding = false; refresh()
                        return
                    end
                    if boundKey and input.KeyCode.Name == boundKey then onFire() end
                end)

                return {
                    GetKey = function(_) return boundKey end,
                    SetKey = function(_, k) boundKey = k; refresh() end,
                }
            end

            function Section:AddToggle(name, cfg)
                cfg = cfg or {}
                local isOn = cfg.Default  or false
                local cb   = cfg.Callback or function() end
                local id   = cfg.Id       or name

                local row = makeRow()
                rowLbl(row, name)

                local kb, kbs = makeBadge(row, -106)

                local pill = Instance.new("Frame"); pill.ZIndex = 3
                pill.Position = UDim2.new(1,-56,0.5,-12); pill.Size = UDim2.new(0,46,0,24)
                pill.BackgroundColor3 = isOn and Theme.ToggleOn or Theme.ToggleOff
                pill.BackgroundTransparency = isOn and 0.1 or 0.75
                pill.BorderSizePixel = 0; pill.Parent = row
                local pc = Instance.new("UICorner"); pc.CornerRadius = UDim.new(1,0); pc.Parent = pill
                local ps = Instance.new("UIStroke"); ps.Color = Theme.Accent; ps.Transparency = 0.65; ps.Parent = pill

                local knob = Instance.new("Frame"); knob.ZIndex = 4
                knob.Position = isOn and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
                knob.Size = UDim2.new(0,18,0,18); knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
                knob.BackgroundTransparency = isOn and 0 or 0.35
                knob.BorderSizePixel = 0; knob.Parent = pill
                local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1,0); kc.Parent = knob

                local pillBtn = Instance.new("TextButton"); pillBtn.ZIndex = 5
                pillBtn.Size = UDim2.new(1,0,1,0); pillBtn.BackgroundTransparency = 1
                pillBtn.Text = ""; pillBtn.Parent = pill

                local function setState(v)
                    isOn = v
                    tw(pill, 0.15, {BackgroundColor3 = v and Theme.ToggleOn or Theme.ToggleOff, BackgroundTransparency = v and 0.1 or 0.75})
                    tw(knob, 0.15, {Position = v and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9), BackgroundTransparency = v and 0 or 0.35})
                    cb(v)
                end

                pillBtn.MouseButton1Click:Connect(function() setState(not isOn) end)

                local kbCtrl = wireKeybind(kb, kbs, function() setState(not isOn) end)

                local ctrl = {
                    Set    = function(_, v) setState(v) end,
                    Get    = function(_) return isOn end,
                    GetKey = kbCtrl.GetKey,
                    SetKey = kbCtrl.SetKey,
                }
                registerElement(id, function() return isOn end, ctrl.Set, "toggle")
                return ctrl
            end

            function Section:AddTextbox(name, cfg)
                cfg = cfg or {}
                local cb = cfg.Callback or function() end
                local w  = cfg.Width    or 50

                local row = makeRow()
                rowLbl(row, name)

                local tb = Instance.new("TextBox"); tb.ZIndex = 5
                tb.Position = UDim2.new(1,-(w+4),0.5,-11); tb.Size = UDim2.new(0,w,0,22)
                tb.BackgroundColor3 = Color3.fromRGB(18,18,18); tb.BorderSizePixel = 0
                tb.Text = tostring(cfg.Default or ""); tb.TextColor3 = Theme.Accent; tb.TextSize = 11
                tb.Font = Enum.Font.Gotham; tb.PlaceholderColor3 = Color3.fromRGB(166,26,26)
                tb.ClearTextOnFocus = false; tb.Parent = row
                local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0,5); tc.Parent = tb
                local ts = Instance.new("UIStroke"); ts.Color = Theme.Accent; ts.Parent = tb

                tb.FocusLost:Connect(function() cb(tb.Text) end)

                return {
                    Set = function(_, v) tb.Text = tostring(v) end,
                    Get = function(_) return tb.Text end,
                }
            end

            function Section:AddKeybind(name, cfg)
                cfg = cfg or {}
                local cb = cfg.Callback or function() end

                local row = makeRow()
                rowLbl(row, name)

                local kb, kbs = makeBadge(row, -56)
                local ctrl = wireKeybind(kb, kbs, cb)

                return {
                    GetKey = ctrl.GetKey,
                    SetKey = ctrl.SetKey,
                }
            end

            function Section:AddSegment(name, options, cfg)
                cfg = cfg or {}
                local activeIdx = cfg.Default  or 1
                local cb        = cfg.Callback or function() end
                local segW      = cfg.Width    or 92
                local id        = cfg.Id       or name

                local row = makeRow()
                rowLbl(row, name)

                local seg = Instance.new("Frame"); seg.ZIndex = 3
                seg.Position = UDim2.new(1,-(segW+6),0.5,-9); seg.Size = UDim2.new(0,segW,0,18)
                seg.BackgroundColor3 = Color3.fromRGB(10,10,10); seg.BorderSizePixel = 0; seg.Parent = row
                local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0,5); sc.Parent = seg
                local ss = Instance.new("UIStroke"); ss.Color = Theme.Accent; ss.Parent = seg

                local pills = {}
                for i, opt in ipairs(options) do
                    local a = (i == activeIdx)
                    local b = Instance.new("TextButton"); b.ZIndex = 4
                    b.Position = UDim2.new((i-1)*0.5, i==1 and 2 or 0, 0, 2)
                    b.Size = UDim2.new(0.5, a and 0 or -2, 1, -4)
                    b.BackgroundColor3 = a and Theme.Accent or Color3.fromRGB(10,10,10)
                    b.BorderSizePixel = 0; b.Text = opt
                    b.TextColor3 = a and Theme.AccentText or Theme.Accent
                    b.TextSize = 9; b.Font = Enum.Font.GothamBold; b.AutoButtonColor = false; b.Parent = seg
                    local bc2 = Instance.new("UICorner"); bc2.CornerRadius = UDim.new(0,4); bc2.Parent = b
                    pills[i] = b
                end

                local function setActive(idx)
                    activeIdx = idx
                    for i, p in ipairs(pills) do
                        local a = (i == idx)
                        tw(p, 0.12, {BackgroundColor3 = a and Theme.Accent or Color3.fromRGB(10,10,10),
                                     TextColor3       = a and Theme.AccentText or Theme.Accent})
                    end
                    cb(idx, options[idx])
                end

                for i, p in ipairs(pills) do
                    p.MouseButton1Click:Connect(function() setActive(i) end)
                end

                local ctrl = {
                    Set = function(_, idx) setActive(idx) end,
                    Get = function(_) return activeIdx, options[activeIdx] end,
                }
                registerElement(id, function() return activeIdx end, ctrl.Set, "segment")
                return ctrl
            end

            function Section:AddButton(name, cfg)
                cfg = cfg or {}
                local cb    = cfg.Callback or function() end
                local label = cfg.Label    or name

                local row = makeRow()

                local btn = Instance.new("TextButton"); btn.ZIndex = 5
                btn.Position = UDim2.new(0,10,0.5,-12); btn.Size = UDim2.new(1,-20,0,24)
                btn.BackgroundColor3 = Theme.Accent; btn.BorderSizePixel = 0
                btn.Text = label; btn.TextColor3 = Theme.AccentText
                btn.TextSize = 12; btn.Font = Enum.Font.GothamBold
                btn.AutoButtonColor = false; btn.Parent = row

                local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,8); bc.Parent = btn

                local bg2 = Instance.new("UIGradient")
                bg2.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 70, 70)),
                    ColorSequenceKeypoint.new(1,   Color3.fromRGB(180, 20, 20)),
                }); bg2.Rotation = 90; bg2.Parent = btn

                local bstroke = Instance.new("UIStroke")
                bstroke.Color = Color3.fromRGB(255, 100, 100)
                bstroke.Transparency = 0.55; bstroke.Thickness = 1.2; bstroke.Parent = btn

                btn.MouseButton1Click:Connect(function()
                    -- escurece o gradiente e o background
                    bg2.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 30, 30)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 10, 10)),
                    })
                    tw(btn, 0.07, {BackgroundColor3 = Theme.AccentDim, Size = UDim2.new(1,-24,0,22)})
                    tw(bstroke, 0.07, {Transparency = 0.1})
                    task.delay(0.13, function()
                        bg2.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 20, 20)),
                        })
                        tw(btn, 0.14, {BackgroundColor3 = Theme.Accent, Size = UDim2.new(1,-20,0,24)})
                        tw(bstroke, 0.14, {Transparency = 0.55})
                    end)
                    cb()
                end)

                btn.MouseEnter:Connect(function()
                    tw(btn, 0.12, {BackgroundColor3 = Color3.fromRGB(255, 60, 60)})
                    tw(bstroke, 0.12, {Transparency = 0.3})
                end)
                btn.MouseLeave:Connect(function()
                    tw(btn, 0.12, {BackgroundColor3 = Theme.Accent})
                    tw(bstroke, 0.12, {Transparency = 0.55})
                end)
            end

            function Section:AddDropdown(name, options, cfg)
                cfg = cfg or {}
                local selected = cfg.Default  or options[1]
                local cb       = cfg.Callback or function() end
                local id       = cfg.Id       or name
                local open     = false
                local _justOpened = false

                local row = makeRow()
                rowLbl(row, name)

                local valLbl = Instance.new("TextLabel"); valLbl.ZIndex = 5
                valLbl.Position = UDim2.new(1,-100,0,0); valLbl.Size = UDim2.new(0,80,1,0)
                valLbl.BackgroundTransparency = 1; valLbl.Text = tostring(selected)
                valLbl.TextColor3 = Theme.Accent; valLbl.TextSize = 10
                valLbl.Font = Enum.Font.GothamBold; valLbl.TextXAlignment = Enum.TextXAlignment.Right; valLbl.Parent = row

                local arrow = Instance.new("TextLabel"); arrow.ZIndex = 5
                arrow.Position = UDim2.new(1,-18,0,0); arrow.Size = UDim2.new(0,14,1,0)
                arrow.BackgroundTransparency = 1; arrow.Text = "▾"
                arrow.TextColor3 = Theme.Accent; arrow.TextSize = 12
                arrow.Font = Enum.Font.GothamBold; arrow.Parent = row

                local clickLayer = Instance.new("TextButton"); clickLayer.ZIndex = 7
                clickLayer.Size = UDim2.new(1,0,1,0); clickLayer.BackgroundTransparency = 1
                clickLayer.Text = ""; clickLayer.Parent = row

                local ITEM_H = 30
                local panelH = #options * (ITEM_H + 3) + 12
                local panel = Instance.new("Frame")
                panel.Name = "DDPanel_" .. name
                panel.ZIndex = 201; panel.Visible = false
                panel.Size = UDim2.new(0, 160, 0, panelH)
                panel.BackgroundColor3 = Color3.fromRGB(12,12,14)
                panel.BackgroundTransparency = 0; panel.BorderSizePixel = 0
                panel.ClipsDescendants = true
                panel.Parent = _dropdownOverlay
                local pc = Instance.new("UICorner"); pc.CornerRadius = UDim.new(0,12); pc.Parent = panel
                local ps = Instance.new("UIStroke"); ps.Color = Theme.Accent; ps.Transparency = 0.5; ps.Thickness = 1.2; ps.Parent = panel
                -- gradiente sutil no fundo do painel
                local pg = Instance.new("UIGradient")
                pg.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,   Color3.fromRGB(22,22,26)),
                    ColorSequenceKeypoint.new(1,   Color3.fromRGB(11,11,13)),
                }); pg.Rotation = 90; pg.Parent = panel
                local pul = Instance.new("UIListLayout"); pul.Padding = UDim.new(0,3); pul.Parent = panel
                local ppad = Instance.new("UIPadding")
                ppad.PaddingTop = UDim.new(0,6); ppad.PaddingBottom = UDim.new(0,6)
                ppad.PaddingLeft = UDim.new(0,5); ppad.PaddingRight = UDim.new(0,5); ppad.Parent = panel

                local function positionPanel()
                    local abs = row.AbsolutePosition
                    local sz  = row.AbsoluteSize
                    local sy  = ScreenGui.AbsoluteSize.Y
                    local px  = abs.X
                    local py  = abs.Y + sz.Y + 5
                    if py + panelH > sy then
                        py = abs.Y - panelH - 5
                    end
                    panel.Position = UDim2.new(0, px, 0, py)
                    panel.Size     = UDim2.new(0, sz.X, 0, panelH)
                end

                local _clickingOption = false
                local _optBtns = {}

                for _, opt in ipairs(options) do
                    local optFrame = Instance.new("Frame"); optFrame.ZIndex = 202
                    optFrame.Size = UDim2.new(1,0,0,ITEM_H)
                    local isSel = (opt == selected)
                    optFrame.BackgroundColor3 = isSel and Color3.fromRGB(255,40,40) or Color3.fromRGB(28,28,32)
                    optFrame.BackgroundTransparency = isSel and 0.75 or 0.3
                    optFrame.BorderSizePixel = 0; optFrame.Parent = panel
                    local ofc = Instance.new("UICorner"); ofc.CornerRadius = UDim.new(0,7); ofc.Parent = optFrame

                    local optLbl = Instance.new("TextLabel"); optLbl.ZIndex = 203
                    optLbl.Position = UDim2.new(0,10,0,0); optLbl.Size = UDim2.new(1,-28,1,0)
                    optLbl.BackgroundTransparency = 1; optLbl.Text = opt
                    optLbl.TextColor3 = isSel and Theme.Accent or Theme.TextSecondary
                    optLbl.TextSize = 11; optLbl.Font = Enum.Font.GothamBold
                    optLbl.TextXAlignment = Enum.TextXAlignment.Left; optLbl.Parent = optFrame

                    local optCheck = Instance.new("TextLabel"); optCheck.ZIndex = 203
                    optCheck.Position = UDim2.new(1,-20,0,0); optCheck.Size = UDim2.new(0,16,1,0)
                    optCheck.BackgroundTransparency = 1; optCheck.Text = isSel and "✓" or ""
                    optCheck.TextColor3 = Theme.Accent; optCheck.TextSize = 11
                    optCheck.Font = Enum.Font.GothamBold; optCheck.Parent = optFrame

                    local optBtn = Instance.new("TextButton"); optBtn.ZIndex = 204
                    optBtn.Size = UDim2.new(1,0,1,0); optBtn.BackgroundTransparency = 1
                    optBtn.Text = ""; optBtn.AutoButtonColor = false; optBtn.Parent = optFrame

                    _optBtns[opt] = {frame=optFrame, lbl=optLbl, check=optCheck}

                    optBtn.MouseEnter:Connect(function()
                        if opt ~= selected then
                            tw(optFrame, 0.1, {BackgroundColor3 = Color3.fromRGB(50,50,56), BackgroundTransparency = 0.2})
                            tw(optLbl, 0.1, {TextColor3 = Theme.TextPrimary})
                        end
                    end)
                    optBtn.MouseLeave:Connect(function()
                        if opt ~= selected then
                            tw(optFrame, 0.1, {BackgroundColor3 = Color3.fromRGB(28,28,32), BackgroundTransparency = 0.3})
                            tw(optLbl, 0.1, {TextColor3 = Theme.TextSecondary})
                        end
                    end)
                    optBtn.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1
                        or i.UserInputType == Enum.UserInputType.Touch then
                            _clickingOption = true
                        end
                    end)
                    optBtn.MouseButton1Click:Connect(function()
                        _clickingOption = false
                        local prev = selected
                        selected = opt; valLbl.Text = opt
                        -- atualizar visual de todos
                        for o, els in pairs(_optBtns) do
                            local isCur = (o == opt)
                            tw(els.frame, 0.12, {
                                BackgroundColor3       = isCur and Color3.fromRGB(255,40,40) or Color3.fromRGB(28,28,32),
                                BackgroundTransparency = isCur and 0.75 or 0.3,
                            })
                            tw(els.lbl,  0.12, {TextColor3 = isCur and Theme.Accent or Theme.TextSecondary})
                            els.check.Text = isCur and "✓" or ""
                        end
                        task.delay(0.1, function()
                            panel.Visible = false; open = false
                            tw(arrow, 0.1, {Rotation = 0})
                        end)
                        cb(selected)
                    end)
                end

                clickLayer.MouseButton1Click:Connect(function()
                    open = not open
                    _justOpened = open
                    if open then positionPanel() end
                    panel.Visible = open
                    tw(arrow, 0.15, {Rotation = open and 180 or 0})
                    if open then
                        task.delay(0.05, function() _justOpened = false end)
                    end
                end)

                UserInputService.InputBegan:Connect(function(i)
                    if not open then return end
                    if _justOpened then return end
                    if _clickingOption then _clickingOption = false; return end
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                    or i.UserInputType == Enum.UserInputType.Touch then
                        task.wait()
                        if panel.Visible and not _clickingOption then
                            panel.Visible = false; open = false
                            tw(arrow, 0.1, {Rotation = 0})
                        end
                    end
                end)

                local ctrl = {
                    Set = function(_, v) selected = v; valLbl.Text = v end,
                    Get = function(_) return selected end,
                }
                registerElement(id, function() return selected end, ctrl.Set, "dropdown")
                return ctrl
            end

            function Section:AddLabel(name, value)
                local row = makeRow()
                rowLbl(row, name)
                local vl = Instance.new("TextLabel"); vl.ZIndex = 5
                vl.Position = UDim2.new(1,-100,0,0); vl.Size = UDim2.new(0,90,1,0)
                vl.BackgroundTransparency = 1; vl.Text = tostring(value or "")
                vl.TextColor3 = Theme.TextSecondary; vl.TextSize = 10
                vl.Font = Enum.Font.Gotham; vl.TextXAlignment = Enum.TextXAlignment.Right; vl.Parent = row
                return {
                    Set = function(_, v) vl.Text = tostring(v) end,
                    Get = function(_) return vl.Text end,
                }
            end

            function Section:AddSpacer(height)
                local f = Instance.new("Frame"); f.LayoutOrder = tNextOrder()
                f.Size = UDim2.new(1,0,0,height or 8)
                f.BackgroundTransparency = 1; f.BorderSizePixel = 0; f.Parent = self._page
            end

            function Section:AddSlider(name, cfg)
                cfg = cfg or {}
                local min    = cfg.Min      or 0
                local max    = cfg.Max      or 100
                local value  = math.clamp(cfg.Default or min, min, max)
                local suffix = cfg.Suffix   or ""
                local cb     = cfg.Callback or function() end
                local id     = cfg.Id       or name

                local row = makeRow(52)
                rowLbl(row, name)

                local valLbl = Instance.new("TextLabel"); valLbl.ZIndex = 8
                valLbl.Position = UDim2.new(0.58,0,0,0); valLbl.Size = UDim2.new(0.42,-14,0,28)
                valLbl.BackgroundTransparency = 1
                valLbl.Text = tostring(value) .. suffix
                valLbl.TextColor3 = Theme.Accent; valLbl.TextSize = 11
                valLbl.Font = Enum.Font.GothamBold
                valLbl.TextXAlignment = Enum.TextXAlignment.Right; valLbl.Parent = row

                local track = Instance.new("Frame"); track.ZIndex = 7
                track.Position = UDim2.new(0,10,1,-16); track.Size = UDim2.new(1,-20,0,6)
                track.BackgroundColor3 = Color3.fromRGB(35,35,40); track.BorderSizePixel = 0
                track.Parent = row
                local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1,0); tc.Parent = track

                local trackFill = Instance.new("Frame"); trackFill.ZIndex = 8
                trackFill.Size = UDim2.new((value - min)/(max - min), 0, 1, 0)
                trackFill.BackgroundColor3 = Theme.Accent; trackFill.BorderSizePixel = 0
                trackFill.Parent = track
                local tfc = Instance.new("UICorner"); tfc.CornerRadius = UDim.new(1,0); tfc.Parent = trackFill

                local knob = Instance.new("Frame"); knob.ZIndex = 9
                knob.AnchorPoint = Vector2.new(0.5, 0.5)
                knob.Position = UDim2.new((value - min)/(max - min), 0, 0.5, 0)
                knob.Size = UDim2.new(0,12,0,12)
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255); knob.BorderSizePixel = 0
                knob.Parent = track
                local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1,0); kc.Parent = knob

                local dragBtn = Instance.new("TextButton"); dragBtn.ZIndex = 10
                dragBtn.Size = UDim2.new(1,0,1,16); dragBtn.Position = UDim2.new(0,0,0,-8)
                dragBtn.BackgroundTransparency = 1; dragBtn.Text = ""; dragBtn.Parent = track

                local function setValue(v)
                    v = math.clamp(math.round(v), min, max)
                    value = v
                    local t = (v - min) / (max - min)
                    tw(trackFill, 0.06, {Size = UDim2.new(t, 0, 1, 0)})
                    tw(knob, 0.06, {Position = UDim2.new(t, 0, 0.5, 0)})
                    valLbl.Text = tostring(v) .. suffix
                    cb(v)
                end

                local dragging = false
                dragBtn.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                    or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if not dragging then return end
                    if i.UserInputType ~= Enum.UserInputType.MouseMovement
                    and i.UserInputType ~= Enum.UserInputType.Touch then return end
                    local rel = math.clamp(
                        (i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    setValue(min + rel * (max - min))
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                    or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                local ctrl = {
                    Set = function(_, v) setValue(v) end,
                    Get = function(_) return value end,
                }
                registerElement(id, function() return value end, ctrl.Set, "slider")
                return ctrl
            end

            function Section:AddSelectable(name, cfg)
                cfg = cfg or {}
                local isOn = cfg.Default  or false
                local cb   = cfg.Callback or function() end
                local id   = cfg.Id       or name

                local row = makeRow()
                rowLbl(row, name)

                local box = Instance.new("Frame"); box.ZIndex = 3
                box.Position = UDim2.new(1,-36,0.5,-10); box.Size = UDim2.new(0,20,0,20)
                box.BackgroundColor3 = isOn and Theme.Accent or Color3.fromRGB(18,18,22)
                box.BackgroundTransparency = isOn and 0.1 or 0
                box.BorderSizePixel = 0; box.Parent = row
                local bxc = Instance.new("UICorner"); bxc.CornerRadius = UDim.new(0,5); bxc.Parent = box
                local bxs = Instance.new("UIStroke")
                bxs.Color = Theme.Accent; bxs.Transparency = isOn and 0.5 or 0.3; bxs.Parent = box

                local innerDot = Instance.new("Frame"); innerDot.ZIndex = 4
                innerDot.AnchorPoint = Vector2.new(0.5, 0.5)
                innerDot.Position = UDim2.new(0.5,0,0.5,0); innerDot.Size = UDim2.new(0,8,0,8)
                innerDot.BackgroundColor3 = Theme.AccentText
                innerDot.BackgroundTransparency = isOn and 0 or 1
                innerDot.BorderSizePixel = 0; innerDot.Parent = box
                local idc = Instance.new("UICorner"); idc.CornerRadius = UDim.new(1,0); idc.Parent = innerDot

                local clickBtn = Instance.new("TextButton"); clickBtn.ZIndex = 5
                clickBtn.Size = UDim2.new(1,0,1,0); clickBtn.BackgroundTransparency = 1
                clickBtn.Text = ""; clickBtn.Parent = row

                local function setState(v)
                    isOn = v
                    tw(box, 0.15, {
                        BackgroundColor3       = v and Theme.Accent or Color3.fromRGB(18,18,22),
                        BackgroundTransparency = v and 0.1 or 0,
                    })
                    tw(innerDot, 0.15, {BackgroundTransparency = v and 0 or 1})
                    bxs.Transparency = v and 0.5 or 0.3
                    cb(v)
                end

                clickBtn.MouseButton1Click:Connect(function() setState(not isOn) end)

                local ctrl = {
                    Set = function(_, v) setState(v) end,
                    Get = function(_) return isOn end,
                }
                registerElement(id, function() return isOn end, ctrl.Set, "selectable")
                return ctrl
            end

            return Section
        end

        return Tab
    end

    -- aba Configs sempre por último (LayoutOrder 9999)
    local configTab = Window:AddTab("Configs", 9999)
    local uiSec = configTab:AddSection("Interface")

    uiSec:AddKeybind("Close UI keybind", {
        Callback = function()
            setMinimised(not minimised)
        end,
    })

    local profilesSec = configTab:AddSection("Perfis")

    -- lê autoexec do disco
    local _autoExecKey = "LonelyUI_AutoExec"
    local function readAutoExec()
        local store = diskRead()
        return store.autoExec == true, store.autoProfile or nil
    end
    local function writeAutoExec(enabled, profileName)
        local store = diskRead()
        store.autoExec    = enabled
        store.autoProfile = profileName
        diskWrite(store)
    end

    -- textbox + botão salvar
    local profileNameBox = profilesSec:AddTextbox("Nome do perfil", {
        Default  = "minha config",
        Width    = 100,
        Callback = function() end,
    })

    profilesSec:AddButton("Salvar perfil", {
        Label    = "Salvar perfil",
        Callback = function()
            local name = profileNameBox:Get()
            if name == "" then return end
            saveProfile(name, collectConfig())
        end,
    })

    -- dropdown de perfil (corrigido: _ddClickingOption impede fechamento prematuro)
    local selectedProfile = "(nenhum)"

    local function getProfileNames()
        local profiles = listProfiles()
        local names = {}
        for k in pairs(profiles) do table.insert(names, k) end
        table.sort(names)
        if #names == 0 then names = { "(nenhum)" } end
        return names
    end

    local initialNames = getProfileNames()
    selectedProfile = initialNames[1]

    -- row do dropdown
    local ddRow = Instance.new("Frame")
    ddRow.ZIndex = 6; ddRow.LayoutOrder = 998
    ddRow.Size = UDim2.new(1,-2,0,40)
    ddRow.BackgroundColor3 = Color3.fromRGB(255,255,255)
    ddRow.BackgroundTransparency = 0.82; ddRow.BorderSizePixel = 0
    ddRow.Parent = configTab._page
    Instance.new("UICorner", ddRow).CornerRadius = UDim.new(0,10)
    local ddRowS = Instance.new("UIStroke", ddRow); ddRowS.Color = Theme.Border; ddRowS.Transparency = 0.6

    local ddLbl = Instance.new("TextLabel", ddRow)
    ddLbl.ZIndex = 8; ddLbl.Position = UDim2.new(0,11,0,0)
    ddLbl.Size = UDim2.new(0.55,0,1,0); ddLbl.BackgroundTransparency = 1
    ddLbl.Text = "Perfil ativo"; ddLbl.TextColor3 = Theme.TextPrimary; ddLbl.TextSize = 11
    ddLbl.Font = Enum.Font.GothamBold; ddLbl.TextXAlignment = Enum.TextXAlignment.Left

    local ddValLbl = Instance.new("TextLabel", ddRow); ddValLbl.ZIndex = 6
    ddValLbl.Position = UDim2.new(1,-102,0,0); ddValLbl.Size = UDim2.new(0,82,1,0)
    ddValLbl.BackgroundTransparency = 1; ddValLbl.Text = selectedProfile
    ddValLbl.TextColor3 = Theme.Accent; ddValLbl.TextSize = 10
    ddValLbl.Font = Enum.Font.GothamBold; ddValLbl.TextXAlignment = Enum.TextXAlignment.Right

    local ddArrow = Instance.new("TextLabel", ddRow); ddArrow.ZIndex = 6
    ddArrow.Position = UDim2.new(1,-18,0,0); ddArrow.Size = UDim2.new(0,14,1,0)
    ddArrow.BackgroundTransparency = 1; ddArrow.Text = "▾"
    ddArrow.TextColor3 = Theme.Accent; ddArrow.TextSize = 12; ddArrow.Font = Enum.Font.GothamBold

    local ddClickLayer = Instance.new("TextButton", ddRow); ddClickLayer.ZIndex = 7
    ddClickLayer.Size = UDim2.new(1,0,1,0); ddClickLayer.BackgroundTransparency = 1; ddClickLayer.Text = ""

    -- painel flutuante do dropdown de perfis
    local ddPanel = Instance.new("Frame", _dropdownOverlay)
    ddPanel.Name = "DDPanel_Profiles"; ddPanel.ZIndex = 201; ddPanel.Visible = false
    ddPanel.BackgroundColor3 = Color3.fromRGB(14,14,16); ddPanel.BackgroundTransparency = 0.05; ddPanel.BorderSizePixel = 0
    Instance.new("UICorner", ddPanel).CornerRadius = UDim.new(0,10)
    local ddPanelS = Instance.new("UIStroke", ddPanel); ddPanelS.Color = Theme.Accent; ddPanelS.Transparency = 0.4
    local ddPanelUL = Instance.new("UIListLayout", ddPanel); ddPanelUL.Padding = UDim.new(0,2)
    local ddPanelPad = Instance.new("UIPadding", ddPanel)
    ddPanelPad.PaddingTop = UDim.new(0,4); ddPanelPad.PaddingBottom = UDim.new(0,4)
    ddPanelPad.PaddingLeft = UDim.new(0,4); ddPanelPad.PaddingRight = UDim.new(0,4)

    local ddOpen = false
    local _ddJustOpened = false
    local _ddClickingOption = false

    local function rebuildDDPanel(names)
        for _, ch in ipairs(ddPanel:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        local panelH = #names * 28 + 8
        ddPanel.Size = UDim2.new(0,160,0,panelH)
        for _, pname in ipairs(names) do
            local optBtn = Instance.new("TextButton", ddPanel); optBtn.ZIndex = 202
            optBtn.Size = UDim2.new(1,0,0,24)
            optBtn.BackgroundColor3 = Color3.fromRGB(22,22,26)
            optBtn.BackgroundTransparency = 0.3; optBtn.BorderSizePixel = 0
            optBtn.Text = pname
            optBtn.TextColor3 = pname == selectedProfile and Theme.Accent or Theme.TextSecondary
            optBtn.TextSize = 10; optBtn.Font = Enum.Font.GothamBold
            Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0,6)
            -- guard: marca que estamos clicando numa opção
            optBtn.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    _ddClickingOption = true
                end
            end)
            optBtn.MouseButton1Click:Connect(function()
                _ddClickingOption = false
                selectedProfile = pname; ddValLbl.Text = pname
                -- atualiza cor de todos os itens
                for _, ch2 in ipairs(ddPanel:GetChildren()) do
                    if ch2:IsA("TextButton") then
                        ch2.TextColor3 = ch2.Text == pname and Theme.Accent or Theme.TextSecondary
                    end
                end
                ddPanel.Visible = false; ddOpen = false
                tw(ddArrow, 0.1, {Rotation = 0})
            end)
        end
    end

    local function positionDDPanel()
        local abs = ddRow.AbsolutePosition
        local sz  = ddRow.AbsoluteSize
        local sy  = ScreenGui.AbsoluteSize.Y
        local py  = abs.Y + sz.Y + 4
        local pH  = ddPanel.AbsoluteSize.Y
        if py + pH > sy then py = abs.Y - pH - 4 end
        ddPanel.Position = UDim2.new(0, abs.X, 0, py)
        ddPanel.Size     = UDim2.new(0, sz.X, 0, pH)
    end

    rebuildDDPanel(initialNames)

    ddClickLayer.MouseButton1Click:Connect(function()
        local names = getProfileNames()
        rebuildDDPanel(names)
        ddOpen = not ddOpen
        _ddJustOpened = ddOpen
        if ddOpen then positionDDPanel() end
        ddPanel.Visible = ddOpen
        tw(ddArrow, 0.15, {Rotation = ddOpen and 180 or 0})
        if ddOpen then task.delay(0.05, function() _ddJustOpened = false end) end
    end)

    UserInputService.InputBegan:Connect(function(i)
        if not ddOpen then return end
        if _ddJustOpened then return end
        if _ddClickingOption then _ddClickingOption = false; return end
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            task.wait()
            if ddPanel.Visible and not _ddClickingOption then
                ddPanel.Visible = false; ddOpen = false
                tw(ddArrow, 0.1, {Rotation = 0})
            end
        end
    end)

    -- seção Ações: carregar + deletar + toggle autoexec
    local actionsSec = configTab:AddSection("Ações")

    actionsSec:AddButton("Carregar config", {
        Label    = "Carregar config",
        Callback = function()
            if selectedProfile == "(nenhum)" then return end
            local data = loadProfile(selectedProfile)
            applyConfig(data, true)
        end,
    })

    actionsSec:AddButton("Deletar config", {
        Label    = "Deletar config",
        Callback = function()
            if selectedProfile == "(nenhum)" then return end
            deleteProfile(selectedProfile)
            local names = getProfileNames()
            rebuildDDPanel(names)
            selectedProfile = names[1]
            ddValLbl.Text = selectedProfile
            -- se era a config auto, limpa
            local ae, ap = readAutoExec()
            if ae and ap == selectedProfile then
                writeAutoExec(false, nil)
            end
        end,
    })

    -- toggle auto-executar
    local _initAutoExec, _initAutoProfile = readAutoExec()
    actionsSec:AddToggle("Auto-executar ao iniciar", {
        Default  = _initAutoExec,
        Callback = function(v)
            writeAutoExec(v, v and selectedProfile or nil)
        end,
    })

    -- auto-exec na inicialização
    if _initAutoExec and _initAutoProfile and _initAutoProfile ~= "(nenhum)" then
        task.defer(function()
            local data = loadProfile(_initAutoProfile)
            if data then
                applyConfig(data, true)
                -- seleciona o perfil no dropdown
                selectedProfile = _initAutoProfile
                ddValLbl.Text   = _initAutoProfile
                local names = getProfileNames()
                rebuildDDPanel(names)
            end
        end)
    end

    function Window:SetThemeColor(color)
        Theme.Accent  = color
        Theme.ToggleOn = color
        Theme.Border  = color
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    function Window:SaveProfile(name)
        local data = collectConfig()
        saveProfile(name, data)
        return data
    end

    function Window:LoadProfile(name, execute)
        local data = loadProfile(name)
        applyConfig(data, execute)
    end

    function Window:ListProfiles()
        return listProfiles()
    end

    function Window:SetMinimised(v)
        setMinimised(v)
    end

    return Window
end

return LonelyUI
